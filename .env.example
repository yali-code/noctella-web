# --- API ---
API_PORT=4000
NODE_ENV=development

# --- Database (SQLite file path; use ":memory:" for ephemeral/test runs) ---
DATABASE_URL=./data/dev.sqlite

# --- Auth (unused Sprint 1 scaffolding - not read by the Sprint 64B session-cookie auth below) ---
JWT_SECRET=replace_with_secret
SESSION_SECRET=replace_with_secret

# --- Sprint 64B admin authentication ---
# Comma-separated allowlist of admin app origins allowed to make credentialed (cookie) requests,
# e.g. http://localhost:3001 in development, https://admin.example.com in production.
ADMIN_APP_ORIGIN=http://localhost:3001
# Sprint 64C: comma-separated allowlist of storefront origins, so the browser accepts CORS
# responses for the public guest-checkout routes (POST /api/orders, /api/payments/*), e.g.
# http://localhost:3000 in development, https://shop.example.com in production.
STOREFRONT_APP_ORIGIN=http://localhost:3000
# Optional. Leave unset for host-only cookies (correct for local dev and for a single-host
# deployment). Set to a shared parent domain (e.g. .example.com) only if the admin app and API
# are deployed on different subdomains of the same registrable domain.
COOKIE_DOMAIN=
# Static bearer token for scheduler-triggered POST /api/background-jobs/run. Independent of
# admin sessions and of ERP_API_KEY - never reuse either for this.
SCHEDULER_AUTH_TOKEN=replace_with_token
# Consumed once by `npm run bootstrap:admin -w apps/api` to create the first Owner admin account.
# Not read by the running server. No effect once an admin user already exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- ERP integration (placeholder) ---
ERP_API_BASE_URL=https://erp.example.internal
ERP_API_KEY=replace_with_key

# --- AI listing generation (placeholder) ---
AI_PROVIDER_API_KEY=replace_with_key

# --- Social login (future) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Storefront / Admin public config ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Sprint 11 marketplace publishing (generate a 32-byte base64 key; do not commit real secrets)
MARKETPLACE_CREDENTIAL_ENCRYPTION_KEY=
MARKETPLACE_OAUTH_STATE_SECRET=
MARKETPLACE_REQUEST_TIMEOUT_MS=10000
MARKETPLACE_PUBLISH_MAX_RETRIES=3
EBAY_API_BASE_URL=https://api.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
ETSY_API_BASE_URL=https://api.etsy.com
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REDIRECT_URI=

# Sprint 12 marketplace webhooks/import retries (test/configurable HMAC secrets; do not commit real secrets)
MARKETPLACE_IMPORT_MAX_RETRIES=3
EBAY_WEBHOOK_SECRET=
ETSY_WEBHOOK_SECRET=
