# =============================================================================
# Noctella ERP - environment variables
#
# Every entry below is a placeholder. Never commit real secret values.
#
# Labels used throughout this file:
#   [STAGING-REQUIRED]  must be set to a real value for a safe Render staging deploy
#                       (see docs/deployment/render-staging.md) - left unset/default, the
#                       app either crashes at startup or a core flow silently breaks.
#   [OPTIONAL]          has a safe default or guarded fallback; fine to leave unset.
#   [SERVER-ONLY]       read only by a Node server process (apps/api, or apps/admin's
#                       server-side code) - never sent to a browser.
#   [NEXT_PUBLIC]       inlined into the Next.js client bundle at build time - visible in
#                       the browser. Never put a secret in a NEXT_PUBLIC_ variable.
#   [CLI-ONLY]          consumed only by a one-off script (bootstrap/reset), not by the
#                       running server.
# =============================================================================

# --- API [SERVER-ONLY] ---
# [OPTIONAL] Local-dev port. Render assigns PORT itself (apps/api/src/serverLifecycle.ts
# reads PORT first, then falls back to API_PORT, then 4000) - do not set API_PORT in Render.
API_PORT=4000
# [STAGING-REQUIRED] Must be exactly "production" for the session cookie to get the Secure
# attribute (apps/api/src/auth/cookies.ts) once staging is served over HTTPS.
NODE_ENV=development

# --- Database [SERVER-ONLY] ---
# [STAGING-REQUIRED for this pass] "sqlite" | "postgres" | "supabase-postgres". This staging
# environment deliberately stays on "sqlite" with a persistent disk - PostgreSQL/Supabase
# migration is explicitly deferred (see docs/deployment/render-staging.md).
DATABASE_DRIVER=sqlite
# [STAGING-REQUIRED] SQLite file path when DATABASE_DRIVER=sqlite (use ":memory:" for
# ephemeral/test runs). In Render staging this must point at the mounted persistent disk, e.g.
# /var/data/noctella.sqlite - the app does not create or mount that disk itself.
# [LOCAL DEV] Prefer a stable absolute path (e.g. C:\Users\you\noctella-local-data\dev.sqlite)
# over this relative default. A relative path is resolved against the process's working
# directory at startup - starting the API from a different directory (a different terminal, IDE
# run config, etc.) silently opens or creates a DIFFERENT, empty database at that new location
# instead of your real one. See docs/deployment/local-development.md.
DATABASE_URL=./data/dev.sqlite
# [OPTIONAL, deferred] Postgres/Supabase connection surface - not used while
# DATABASE_DRIVER=sqlite. Documented here so it isn't undiscoverable if/when this environment
# migrates off SQLite; none of these are read for the current staging deployment.
SUPABASE_DATABASE_URL=
SUPABASE_PROJECT_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# [OPTIONAL] Defaults to "SQLiteOnly". Only relevant once a Postgres/Supabase cutover begins.
DATABASE_CUTOVER_STATE=SQLiteOnly
# [OPTIONAL] Must be exactly "true" to unblock DATABASE_CUTOVER_STATE=SupabasePrimary. Leave
# unset while on SQLite.
DATABASE_SUPABASE_PRIMARY_VERIFIED=
# [OPTIONAL] Dual-write mode is not supported - setting this to "true" makes startup fail
# closed by design. Leave unset.
DATABASE_DUAL_WRITE=
# [OPTIONAL] Must be exactly "true" to allow real Postgres migration-batch execution. Leave
# unset/false while on SQLite.
DATABASE_MIGRATION_EXECUTION_ENABLED=
# [OPTIONAL] Postgres connection pool tuning - only consulted when DATABASE_DRIVER is
# postgres/supabase-postgres.
DATABASE_POOL_TIMEOUT_MS=5000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_MAX=5
# [OPTIONAL] When "true", `npm run db:backup-check -w apps/api` exits non-zero if no local
# backup file is found; otherwise that check is informational only.
DATABASE_BACKUP_CHECK_STRICT=

# --- Payments [SERVER-ONLY] ---
# [STAGING-REQUIRED] Sprint 76: every payment provider shipped so far (Stripe, PayPal, Cash on
# Delivery) is a mock - initializePayment/verifyPayment/cancelPayment never contact a real
# gateway, and verifyPayment always reports "Paid". Safe default is deny-unless-explicitly-
# opted-in: leave unset for local dev/test (mock payments stay usable, matching all current
# behavior), set explicitly to "true" wherever mock payments must intentionally remain available
# despite NODE_ENV=production (e.g. Render staging - see render.yaml), or "false" to disable mock
# payments in any environment, including outside production. When NODE_ENV=production and this
# is left unset, mock payment initialize/verify/cancel are rejected - this must never be set to
# "true" for a real production deployment before a real payment gateway is integrated.
MOCK_PAYMENTS_ENABLED=

# --- Admin operator recovery scripts [CLI-ONLY] ---
# Consumed once by `npm run bootstrap:admin -w apps/api` to create the first Owner admin
# account. Not read by the running server. No effect once an admin user already exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Consumed only by `npm run reset:admin-password -w apps/api` (apps/api/src/scripts/
# resetAdminPassword.ts) - an operator-run password-reset script, not an HTTP-reachable flow.
RESET_ADMIN_EMAIL=
RESET_ADMIN_PASSWORD=

# --- Auth (unused Sprint 1 scaffolding - not read by the Sprint 64B session-cookie auth below) ---
JWT_SECRET=replace_with_secret
SESSION_SECRET=replace_with_secret

# --- Sprint 64B admin authentication [SERVER-ONLY] ---
# [STAGING-REQUIRED] Comma-separated allowlist of admin app origins allowed to make
# credentialed (cookie) requests, e.g. http://localhost:3001 in development,
# https://admin.staging.noctella.com in staging.
ADMIN_APP_ORIGIN=http://localhost:3001
# [STAGING-REQUIRED] Sprint 64C: comma-separated allowlist of storefront origins, so the
# browser accepts CORS responses for the public guest-checkout routes (POST /api/orders,
# /api/payments/*), e.g. http://localhost:3000 in development,
# https://shop.staging.noctella.com in staging.
STOREFRONT_APP_ORIGIN=http://localhost:3000
# [STAGING-REQUIRED whenever Admin and API are on different subdomains] Leave unset for
# host-only cookies (correct for local dev and for a single-host deployment - different ports
# on "localhost" count as the same host). Set to a shared parent domain (e.g.
# .staging.noctella.com) when the admin app and API are deployed on different subdomains of
# the same registrable domain, or apps/admin's server-side data fetching will silently receive
# no session cookie.
COOKIE_DOMAIN=
# [STAGING-REQUIRED] Static bearer token for scheduler-triggered POST /api/background-jobs/run
# (see apps/api/src/scripts/runBackgroundJobs.ts, invoked by Render Cron). Independent of admin
# sessions and of ERP_INTEGRATION_KEY - never reuse either for this.
SCHEDULER_AUTH_TOKEN=replace_with_token

# --- ERP integration [SERVER-ONLY] ---
# Unused - no current code reads this. apps/admin's server-side ERP client
# (apps/admin/src/lib/server/erpServerClient.ts) targets NEXT_PUBLIC_API_BASE_URL instead.
# Kept only so an operator who previously set it isn't surprised it disappeared; do not rely on
# it for anything.
ERP_API_BASE_URL=https://erp.example.internal
# [STAGING-REQUIRED] Server-only key apps/admin's ERP client
# (apps/admin/src/lib/server/erpServerClient.ts) sends as X-Noctella-ERP-Key, and apps/api's
# requireErp validates. Must match on both sides.
ERP_INTEGRATION_KEY=replace_with_key
# [OPTIONAL] Salt used when hashing ERP_INTEGRATION_KEY for comparison
# (apps/api/src/services/erpIntegration.ts). Has a built-in default; set explicitly in staging
# for a deployment-specific value.
ERP_INTEGRATION_KEY_SALT=
# [OPTIONAL] Cosmetic metadata attached to ERP auth audit rows only - not used for validation.
ERP_INTEGRATION_KEY_VERSION=
# [OPTIONAL] Comma-separated allowlist for the ERP router's own CORS preflight handling
# (apps/api/src/routes/erp.ts) - distinct from ADMIN_APP_ORIGIN/STOREFRONT_APP_ORIGIN. Only
# needed if a browser-based ERP client calls these routes directly cross-origin.
ERP_CORS_ORIGINS=
# [OPTIONAL] Sent as X-Noctella-ERP-Client-Version on every apps/admin ERP request. Defaults
# to 0.1.0 in erpServerClient.ts when unset.
ERP_CLIENT_VERSION=0.1.0

# --- Product photo storage [SERVER-ONLY] ---
# [STAGING-REQUIRED] Local disk directory apps/api writes uploaded product photos to
# (apps/api/src/services/photoStorage.ts), served back via /images/product-photos. Defaults to
# ./uploads/product-photos under the process's working directory - in Render staging this must
# point at the mounted persistent disk (e.g. /var/data/product-photos), or every uploaded photo
# is lost on the next deploy/restart.
# [LOCAL DEV] Prefer a stable absolute path outside any generated build directory (e.g.
# C:\Users\you\noctella-local-data\product-photos), for the same reason as DATABASE_URL above -
# a relative path here is resolved against the working directory at startup, so starting the API
# from a different directory silently starts writing/reading photos in a different, empty
# location. See docs/deployment/local-development.md.
PRODUCT_PHOTO_DIR=./uploads/product-photos

# --- AI listing generation (placeholder) ---
AI_PROVIDER_API_KEY=replace_with_key

# --- Social login (future) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Storefront / Admin public config [NEXT_PUBLIC] ---
# [STAGING-REQUIRED] Read by both apps/admin and apps/storefront, at build time and at
# runtime. Set to the deployed API's public URL, e.g. https://api.staging.noctella.com.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Storefront SEO metadata [SERVER-ONLY] ---
# [STAGING-REQUIRED] Sprint 73: the Storefront's own canonical origin, used server-side only
# (generateMetadata, sitemap.ts, robots.ts) to build canonical/Open Graph URLs - never inlined
# into the client bundle, so it is NOT prefixed NEXT_PUBLIC_. Must start with http:// or https://
# and have no trailing slash. Local dev: http://localhost:3000. Current staging:
# https://shop.staging.noctella.com. Required (no localhost fallback) once NODE_ENV=production.
STOREFRONT_SITE_URL=http://localhost:3000

# --- Marketplace publishing [SERVER-ONLY, deferred/optional for this staging pass] ---
# Sprint 11 marketplace publishing (generate a 32-byte base64 key; do not commit real secrets).
# [STAGING-REQUIRED] required for any marketplace OAuth credential encrypt/decrypt to work at
# all - throws on first use if unset.
MARKETPLACE_CREDENTIAL_ENCRYPTION_KEY=
# [OPTIONAL] Falls back to MARKETPLACE_CREDENTIAL_ENCRYPTION_KEY when unset.
MARKETPLACE_OAUTH_STATE_SECRET=
MARKETPLACE_REQUEST_TIMEOUT_MS=10000
MARKETPLACE_PUBLISH_MAX_RETRIES=3
EBAY_API_BASE_URL=https://api.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
ETSY_API_BASE_URL=https://api.etsy.com
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REDIRECT_URI=

# Sprint 12 marketplace webhooks/import retries (do not commit real secrets).
# Sprint 77: there is no fallback/default HMAC secret. Leaving either *_WEBHOOK_SECRET unset,
# empty, or whitespace-only makes signature verification for that channel fail closed (all
# webhook requests for that channel are rejected) rather than accepting a known test value.
MARKETPLACE_IMPORT_MAX_RETRIES=3
EBAY_WEBHOOK_SECRET=
ETSY_WEBHOOK_SECRET=
